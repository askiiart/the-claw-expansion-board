	)
	(text "WARNING\nthis is designed for 7.5A going to any output (except fans - 5.8A max)\n\nhowever, XH is only rated for 3A, and ZPD for 2A.\nuse above that current at your own risk"
		(exclude_from_sim no)
		(at 124.206 182.626 0)
